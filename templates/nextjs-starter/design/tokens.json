{
  "$description": "DTCG design tokens. `/site-builder:tokens` regenerates this per site. Token paths are named so Style Dictionary emits Tailwind v4 @theme namespaces (--color-*, --radius-*, --shadow-*, --font-*).",
  "color": {
    "bg": { "$value": "#ffffff", "$type": "color" },
    "fg": { "$value": "#0a0a0a", "$type": "color" },
    "muted": { "$value": "#5b616e", "$type": "color" },
    "border": { "$value": "#e5e7eb", "$type": "color" },
    "brand": {
      "500": { "$value": "#4f46e5", "$type": "color" },
      "600": { "$value": "#4338ca", "$type": "color" }
    },
    "on-brand": { "$value": "#ffffff", "$type": "color" }
  },
  "radius": {
    "md": { "$value": "0.5rem", "$type": "dimension" },
    "lg": { "$value": "0.75rem", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px 0 rgba(10,10,10,0.06)", "$type": "shadow" },
    "md": { "$value": "0 8px 24px -6px rgba(10,10,10,0.12)", "$type": "shadow" }
  },
  "font": {
    "sans": {
      "$value": "var(--font-sans-stack), ui-sans-serif, system-ui, sans-serif",
      "$type": "fontFamily"
    }
  }
}
